    "test:emulator": "node --test test/emulator.integration.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.4"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
