OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ALLOWED_PHONE_NUMBER=
ALLOWED_UID=
# The store's own ח.פ/ע.מ, as printed under "לכבוד" on every supplier invoice.
# It is what separates the supplier's identifier from the recipient's.
STORE_TAX_ID=
FIREBASE_PROJECT_ID=kiri-store-accounting
FIREBASE_STORAGE_BUCKET=kiri-store-accounting.firebasestorage.app
ALLOWED_ORIGIN=https://kiri-store-accounting.web.app,https://kiri-store-accounting.firebaseapp.com
MAX_SCANS_PER_DAY=30
MAX_SCANS_PER_MONTH=900
PORT=8080
NODE_ENV=production
